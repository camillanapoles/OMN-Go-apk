# STAGE 1: Toolchains & Cache
#
# The stages go_env and base_env are the same as in Dockerfile.ci. Keep
# the two files in step. base_env is the last stage, thus it is the image
# that local/build.sh tags as omn-go-base:latest.
#
# THE GO VERSION. The image is golang:1.26.0-bookworm, and not the moving
# tag golang:1.26-bookworm. The F-Droid recipe builds with the srclib
# go@go1.26.0. The two builds thus use the same compiler. Change both
# together.
FROM golang:1.26.0-bookworm AS go_env

ENV DEBIAN_FRONTEND=noninteractive

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y \
    openjdk-17-jdk nodejs wget unzip cmake ninja-build

WORKDIR /app

# The repository holds no go.sum, and the host has no Go toolchain. This
# step thus makes go.sum here, one time for each change of go.mod. It also
# adds golang.org/x/mobile as a tool dependency, because the committed
# go.mod does not name it.
#
# The step keeps the result in /root/lockfiles, and not in /app. The later
# "COPY . ." brings in the go.mod of the host, which has no go.sum and no
# x/mobile. /root/lockfiles is outside that copy, thus the next step can
# restore the full files.
#
# A second .dockerignore file can also keep go.mod out of the copy. An
# earlier version did that. BuildKit then used that file in place of the
# root .dockerignore, and each other exclusion went away. The copy to
# /root/lockfiles needs no ignore file.
COPY go.mod ./
RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go get -tool golang.org/x/mobile/cmd/gobind golang.org/x/mobile/cmd/gomobile && \
    go mod download && \
    mkdir -p /root/lockfiles && cp go.mod go.sum /root/lockfiles/

FROM go_env AS base_env

# Install Android CMD Line Tools
RUN --mount=type=cache,target=/tmp/dl,sharing=locked \
    wget -q https://dl.google.com/android/repository/commandlinetools-linux-10406996_latest.zip -O /tmp/dl/cmd.zip && \
    mkdir -p /opt/android/cmdline-tools && \
    unzip -q /tmp/dl/cmd.zip -d /opt/android/cmdline-tools && \
    mv /opt/android/cmdline-tools/cmdline-tools /opt/android/cmdline-tools/latest

ENV ANDROID_HOME=/opt/android
ENV PATH=$PATH:$ANDROID_HOME/cmdline-tools/latest/bin:$ANDROID_HOME/platform-tools

# build-tools 34.0.0, because that is the version the build asks for. The
# Gradle plugin (com.android.tools.build:gradle:8.2.2 - see
# android/build.gradle) carries a default build-tools version, and
# android/app/build.gradle pins none. With 33.0.1 in the image, the gradle
# step of stage 2 stopped to accept a license and to download 34.0.0 on
# each build. That download needs the network at build time. It also
# writes into the image, and the next build cannot use the result. The
# SDK lives here, and not under the /root/.gradle cache mount.
#
# The Gradle configuration stays as it is. F-Droid builds this project
# from that configuration, on their own server and with their own SDK.
# The image follows the build, and not the other way.
RUN --mount=type=cache,target=/opt/android/.android/cache,sharing=locked \
    yes | sdkmanager --licenses && \
    sdkmanager "platforms;android-34" "build-tools;34.0.0" "platform-tools" "ndk;25.2.9519653"

# Install Gradle
RUN --mount=type=cache,target=/tmp/dl,sharing=locked \
    wget -q https://services.gradle.org/distributions/gradle-8.5-bin.zip -O /tmp/dl/gradle.zip && \
    mkdir -p /opt/gradle && \
    unzip -q /tmp/dl/gradle.zip -d /opt/gradle
ENV PATH=$PATH:/opt/gradle/gradle-8.5/bin

RUN --mount=type=cache,target=/go/pkg/mod,sharing=locked \
    go install golang.org/x/mobile/cmd/gobind && \
    go install golang.org/x/mobile/cmd/gomobile && \
    gomobile init
